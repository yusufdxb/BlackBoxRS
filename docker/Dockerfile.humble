# BlackBoxRS — ROS 2 Humble container
#
# Ships the BlackBoxRS daemon against a known-good ROS 2 environment.
# This is the image used to reproduce the live-rclpy tests described
# in the README; it is the ONLY image that the project claims to
# support at present.  (Other ROS 2 distros may work, but are not
# verified in this repo.)
#
# Build:
#   docker build -f docker/Dockerfile.humble -t blackboxrs:humble .
#
# Start the daemon in the foreground, tailing logs to stdout:
#   docker run --rm --network host \
#       -e ROS_DOMAIN_ID=42 \
#       blackboxrs:humble
#
# Drop into an interactive shell (useful for running pytest inside the
# image to verify live-ROS tests):
#   docker run --rm -it --network host \
#       -e ROS_DOMAIN_ID=42 \
#       --entrypoint bash blackboxrs:humble
#
# The image is intentionally thin: just enough tooling to run the
# daemon, execute live-ROS tests, and support rosbag2 recording. No
# editor or extra application layers are bundled.

FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# python3-pip is not in the base image; install it alongside the
# few rclpy deps the monitor actually touches (std_msgs is used by
# the live test).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3-pip \
        ros-humble-ros2bag \
        ros-humble-rosbag2-storage-default-plugins \
        ros-humble-std-msgs \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/blackboxrs

# Copy only the metadata first so the dep-install layer is cached
# across source edits.
COPY pyproject.toml README.md pytest.ini ./
COPY blackboxrs/ ./blackboxrs/

# Install blackboxrs + test extras so pytest can run against the
# image to reproduce the live-ROS tests. A regular install is more
# robust here than editable mode because the ROS base image does not
# ship a new-enough build backend for PEP 660 by default.
RUN pip3 install --no-cache-dir --upgrade "pip>=24" "setuptools<80" wheel \
 && pip3 install --no-cache-dir ".[dev]"

# Keep the live-ROS integration test in the image so CI can verify the
# real rclpy path without bind-mounting the repository.
COPY tests/ ./tests/
COPY scripts/telemetry_health_publisher.py ./scripts/telemetry_health_publisher.py
COPY examples/demo_runtime_telemetry_health.py ./examples/demo_runtime_telemetry_health.py
COPY examples/telemetry_health/genuine_go2_evidence_summary.json \
     ./examples/telemetry_health/genuine_go2_evidence_summary.json

# Make the CLI discoverable in a ROS-sourced shell.
ENV PATH="/usr/local/bin:${PATH}"

# /root/.blackboxrs is the default config/log root; declare it as a
# volume so bind-mounts are idiomatic.
VOLUME ["/root/.blackboxrs"]

# Default: source ROS, then run the daemon in the foreground.
# The `source` call has to happen inside the shell, so we use bash
# -c rather than exec-form.
ENTRYPOINT ["/bin/bash", "-lc", "source /opt/ros/humble/setup.bash && exec \"$@\"", "--"]
CMD ["robot-blackbox", "start", "--foreground"]
