# BlackBoxRS ROS 2 Humble container
#
# Ships the BlackBoxRS daemon and native capture plane against a known-good ROS 2 environment.
# This is the image used to reproduce the live-rclpy tests described
# in the README; it is the ONLY image that the project claims to
# support at present.  (Other ROS 2 distros may work, but are not
# verified in this repo.)
#
# Build:
#   docker build -f docker/Dockerfile.humble -t blackboxrs:humble .
#
# Start the daemon in the foreground, tailing logs to stdout:
#   docker run --rm --network host \
#       -e ROS_DOMAIN_ID=42 \
#       blackboxrs:humble
#
# Drop into an interactive shell (useful for running pytest inside the
# image to verify live-ROS tests):
#   docker run --rm -it --network host \
#       -e ROS_DOMAIN_ID=42 \
#       --entrypoint bash blackboxrs:humble
#
# The native source, build tree, and package test artifacts stay in the build stage.

FROM ros:humble-ros-base AS native-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        python3-colcon-common-extensions \
        ros-humble-mcap-vendor \
        ros-humble-rclcpp-components \
        ros-humble-std-msgs \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/blackboxrs-native-ws
COPY src/blackbox_capture_cpp/ ./src/blackbox_capture_cpp/

RUN . /opt/ros/humble/setup.sh \
 && colcon --log-base /tmp/blackboxrs-colcon-log build \
        --build-base /tmp/blackboxrs-colcon-build \
        --install-base /opt/blackboxrs/native_install \
        --merge-install \
        --packages-select blackbox_capture_cpp \
        --event-handlers console_direct+ \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF

FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Include the two CI-verified RMW implementations and common ROS interface
# packages so generic native subscriptions can load their type support.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3-pip \
        ros-humble-geometry-msgs \
        ros-humble-mcap-vendor \
        ros-humble-nav-msgs \
        ros-humble-rclcpp-components \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-rmw-fastrtps-cpp \
        ros-humble-ros2bag \
        ros-humble-rosbag2-storage-default-plugins \
        ros-humble-rosbag2-storage-mcap \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
        ros-humble-tf2-msgs \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/blackboxrs

COPY --from=native-builder /opt/blackboxrs/native_install/ ./native_install/

# Copy only the metadata first so the dep-install layer is cached
# across source edits.
COPY pyproject.toml README.md pytest.ini ./
COPY blackboxrs/ ./blackboxrs/

# Install blackboxrs + test extras so pytest can run against the
# image to reproduce the live-ROS tests. A regular install is more
# robust here than editable mode because the ROS base image does not
# ship a new-enough build backend for PEP 660 by default.
RUN pip3 install --no-cache-dir --upgrade "pip>=24" "setuptools<80" wheel \
 && pip3 install --no-cache-dir ".[dev,replay]"

# Keep the live-ROS integration test in the image so CI can verify the
# real rclpy path without bind-mounting the repository.
COPY tests/ ./tests/
COPY scripts/native_capture_bag_gate.py ./scripts/native_capture_bag_gate.py
COPY examples/bags/go2_sim_odom_imu.mcap ./examples/bags/go2_sim_odom_imu.mcap

# Make the CLI discoverable in a ROS-sourced shell.
ENV PATH="/usr/local/bin:${PATH}"

# /root/.blackboxrs is the default config/log root; declare it as a
# volume so bind-mounts are idiomatic.
VOLUME ["/root/.blackboxrs"]

# Default: source ROS, then run the daemon in the foreground.
# The `source` call has to happen inside the shell, so we use bash
# -c rather than exec-form.
ENTRYPOINT ["/bin/bash", "-lc", "source /opt/ros/humble/setup.bash && source /opt/blackboxrs/native_install/setup.bash && exec \"$@\"", "--"]
CMD ["robot-blackbox", "start", "--foreground"]
