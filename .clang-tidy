# Static analysis for cpp/ and ros2/ (clang-tidy 14). Focused on the defects
# that matter here: lifetime and ownership, concurrency, narrowing, needless
# copies, exception safety, uninitialised state. Style-only checks that add
# noise without finding bugs are off; each exclusion says why.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  cert-err58-cpp,
  cert-dcl58-cpp,
  clang-analyzer-*,
  concurrency-*,
  -concurrency-mt-unsafe,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-owning-memory,
  misc-const-correctness,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-unused-parameters,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-make-unique,
  modernize-make-shared,
  modernize-loop-convert,
  modernize-pass-by-value,
  performance-*,
  -performance-inefficient-string-concatenation,
  readability-container-size-empty,
  readability-make-member-function-const,
  readability-redundant-string-cstr,
  readability-inconsistent-declaration-parameter-name,
  readability-simplify-boolean-expr
# bugprone-easily-swappable-parameters: flags every (double, double) helper.
# bugprone-exception-escape: main() and thread bodies catch at the boundary;
#   the check cannot see that nlohmann's accessors are called on known types.
# performance-inefficient-string-concatenation: only error and report text
#   is built that way; the hot paths (record serialization) append.
# concurrency-mt-unsafe: flags getenv/gmtime-style calls made before threads
#   exist or with the _r variants.
WarningsAsErrors: ''
HeaderFilterRegex: '(cpp/include|cpp/src|cpp/tools|ros2/blackboxrs_ros)/.*'
FormatStyle: file
CheckOptions:
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'std::stop_token'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
